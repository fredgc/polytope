# User / Project custom ignores
cached/
.git_chain_data
untranslated_messages.json

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
out/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/app/.cxx
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/key.properties
android/app/src/main/res/values/strings.xml

# Archives and binaries
*.aab
*.aar
*.apk
*.tgz
*.zip

# Widget Preview related
.widget_preview/

# Firebase cache
.firebase/

# Firebase secrets (regenerate them using "flutterfire configure")
firebase_options.dart
lib/firebase_options.dart
google-services.json
android/app/google-services.json

# Environment variables
.env
.env.*

# Node / NPM (if present)
.npm
package-lock.json
node_modules
.eslintcache
.node_repl_history
.yarn-integrity
